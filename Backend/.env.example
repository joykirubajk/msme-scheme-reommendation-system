# Copy to Backend/.env and fill in. Never commit .env.
PORT=8000
NODE_ENV=development

# PostgreSQL (the code reads these five variables, not DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=msme
DB_USER=postgres
DB_PASSWORD=change_me

# Long random string, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
# Login token lifetime (default 7d)
# JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API (default: localhost:3000, localhost:5173, deployed site)
# CORS_ORIGINS=http://localhost:3000

# Python ranking service (optional). If unset or unreachable, a built-in fallback scorer is used.
# RANKING_SERVICE_URL=http://127.0.0.1:8090
# RANKING_TIMEOUT_MS=1500
